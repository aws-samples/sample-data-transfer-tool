# /etc/go-worker/env —— go-worker + rclone-rcd 共享环境（部署时复制并填真实值）。
# 与 Python worker 的注入约定对齐，新增 RCD_* 与并发参数。

# ── AWS / 队列 / 表（每 stack 不同）────────────────────────────────
AWS_REGION=eu-south-2
QUEUE_URL=https://sqs.eu-south-2.amazonaws.com/<ACCT>/<STACK>-queue
DYNAMODB_TABLE=<STACK>-transfer-status
HEARTBEAT_TABLE=<STACK>-heartbeat

# ── rcd 守护进程 ──────────────────────────────────────────────────
RCD_ADDR=127.0.0.1:5572
# 本机鉴权：随便一对强随机值即可（访问 remote 的 rc 方法默认必须鉴权）
RCD_USER=worker
RCD_PASS=<本地随机口令>
RCLONE_CONFIG=/root/.config/rclone/rclone.conf

# ── 并发（核心调参）──────────────────────────────────────────────
# WORKER_GOROUTINES ≈ RCLONE_TRANSFERS：提交并发与执行并发对齐。
# 从几十起步压测，看 GCS/S3 429 率拐点找甜点。in-flight 约束: hosts × WORKER_GOROUTINES ≤ 120000。
WORKER_GOROUTINES=64
RECEIVER_GOROUTINES=2
RCLONE_TRANSFERS=64

# ── 防双写不变量（必须 RCLONE_TIMEOUT ≤ 0.7×VISIBILITY，启动 fail-fast 校验）──
QUEUE_VISIBILITY_TIMEOUT=43200
RCLONE_TIMEOUT_SECONDS=30240

# ── 限速 SSM（worker 每 30s 读，per-call 注入 copyfile _config）──────
RATELIMIT_BWLIMIT_PARAM=/migration/<STACK>/ratelimit/bwlimit
RATELIMIT_TPSLIMIT_PARAM=/migration/<STACK>/ratelimit/tpslimit
