# gcs-sqs-go 部署配置示例
# 用法: ./gcs-sqs-go --config config.env
# 格式: KEY=value，每行一个；# 注释与空行忽略；value 可选带成对引号。
# 这些 key 同时也是环境变量名——不传 --config 时改用环境变量；
# 同时存在时文件值覆盖环境变量。

# 目标 SQS 队列 URL（必填）
SQS_QUEUE_URL=https://sqs.us-west-2.amazonaws.com/xxxxxxxxxx/my-queue

# SQS 所在 AWS region（必填）
AWS_REGION=us-west-2

# 桶映射 CSV 文件路径（必填）。每行 3 列：源GCS桶,目标S3桶,该桶inventory清单的s3://URI。
# 程序遍历该文件每个桶、处理其各自的 inventory。详见 bucket-map.csv.example。
BUCKET_MAP_FILE=bucket-map.csv

# rclone 远端名，须与消费端 rclone.conf 中的 gcs remote 同名（可选，默认 gcs）
GCS_REMOTE=gcs

# 清单（manifest + shard parquet）所在 AWS S3 桶的 region（可选，默认回退 AWS_REGION）。
# 当清单桶与 SQS 队列不在同一 region 时设置。凭证走 AWS 默认凭证链（同 SQS）。
# INVENTORY_S3_REGION=us-east-1

# 清单 shard 的 key 前缀重写（可选）。manifest 的 reportNames 是 gs://<桶>/<gcs前缀>... ；
# 清单从 GCS 同步到 S3 时若把目录前缀改了，需在此声明，否则程序按原前缀拼 S3 路径会 404。
# 映射规则：剥掉 gs:// 桶名 → 把 INVENTORY_GCS_KEY_PREFIX 换成 INVENTORY_S3_KEY_PREFIX → 拼到
# manifest 所在的 S3 桶（shard 与 manifest 须同桶）。例：
#   gs://my-gcs-inventory/parquet/eu-abc/x.parquet
#     →（manifest 在 s3://my-s3-inventory/ops/inventory/...）
#     → s3://my-s3-inventory/ops/inventory/eu-abc/x.parquet
# 两项都不填 = 用默认对 parquet/ → ops/inventory/（当前部署）；都填空串则落回该默认。
# 要彻底关闭重写（S3 上 key 与 GCS 完全一致，仅换桶），把两项设为同一值即可。
# INVENTORY_GCS_KEY_PREFIX=parquet/
# INVENTORY_S3_KEY_PREFIX=ops/inventory/

# 文件大小区间过滤（可选）。带单位：B/KB/MB/GB/TB（二进制基数，1KB=1024；也接受 KiB/MiB…与纯数字=字节）。
# 闭区间 [MIN_SIZE, MAX_SIZE]：仅迁移 size>=MIN 且 size<=MAX 的对象，区间外的被过滤掉（不影响消息体）。
# 都不填=全迁；只填 MIN=只迁大文件；只填 MAX=只迁小文件；都填=区间迁移。
# 用法：要按大小分流到不同队列，就跑两次——一次配小区间发小文件队列，一次配大区间发大文件队列。
# 注意：一旦配置，inventory 必须含 size 列（Storage Insights metadata_fields 勾选 size）。
# MIN_SIZE=100KB
# MAX_SIZE=100MB

# 桶日志上传目标（可选）。日志默认写本地 logs/{源桶名}-{时间戳}.log（每桶一个文件）。
# 配了 LOG_S3_URI 则每个桶处理完后，把该桶日志额外上传到 {LOG_S3_URI}/{源桶名}-{时间戳}.log。
# 凭证/region 复用清单读取（AWS 默认凭证链 + INVENTORY_S3_REGION）。上传失败只告警、不中断。
# LOG_S3_URI=s3://my-log-bucket/gcs-sqs-logs
